{
  "name": "@sprengmeister/graphvault",
  "version": "0.2.1",
  "description": "TypeScript object graph persistence for application-owned object models.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Sprengmeister-dev/graphvault-library.git"
  },
  "homepage": "https://github.com/Sprengmeister-dev/graphvault-library#readme",
  "bugs": {
    "url": "https://github.com/Sprengmeister-dev/graphvault-library/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./nest": {
      "types": "./dist/integrations/nest.d.ts",
      "import": "./dist/integrations/nest.js"
    },
    "./internal/cache/*": {
      "types": "./dist/cache/*.d.ts",
      "import": "./dist/cache/*.js"
    },
    "./internal/concurrency/*": {
      "types": "./dist/concurrency/*.d.ts",
      "import": "./dist/concurrency/*.js"
    },
    "./internal/core/*": {
      "types": "./dist/core/*.d.ts",
      "import": "./dist/core/*.js"
    },
    "./internal/gvql/*": {
      "types": "./dist/gvql/*.d.ts",
      "import": "./dist/gvql/*.js"
    },
    "./internal/lazy/*": {
      "types": "./dist/lazy/*.d.ts",
      "import": "./dist/lazy/*.js"
    },
    "./internal/storage/*": {
      "types": "./dist/storage/*.d.ts",
      "import": "./dist/storage/*.js"
    },
    "./internal/storage-targets/*": {
      "types": "./dist/storage/targets/*.d.ts",
      "import": "./dist/storage/targets/*.js"
    },
    "./internal/storage/targets/*": {
      "types": "./dist/storage/targets/*.d.ts",
      "import": "./dist/storage/targets/*.js"
    }
  },
  "files": [
    "assets",
    "benchmarks",
    "CHANGELOG.md",
    "CONTRIBUTING.md",
    "docs",
    "dist",
    "examples",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test:unit": "npm run build && node tests/smoke.mjs && node tests/parser.test.mjs && node tests/engine.test.mjs && node tests/storage-manager.test.mjs && node tests/concurrency-transactions.test.mjs && node tests/wal-crash-matrix.test.mjs && node tests/storage-target-conformance.test.mjs && node tests/clause-scanner.test.mjs && node tests/gvql-values.test.mjs && node tests/binary-codec.test.mjs && node tests/gvql-index.test.mjs && node tests/mutex.test.mjs && node tests/storage-target-sql.test.mjs && node tests/storage-target-s3.test.mjs && node tests/persistent-cache.test.mjs && node tests/serializer.test.mjs && node tests/lazy-and-storer.test.mjs && node tests/storage-modules.test.mjs && node tests/parser-fuzz.test.mjs",
    "test": "npm run quality:source && c8 npm run test:unit",
    "coverage": "npm run test",
    "benchmark": "npm run build && node benchmarks/object-graph.mjs",
    "benchmark:json": "npm run build && node benchmarks/object-graph.mjs --json --output benchmark-results.json",
    "benchmark:check": "npm run build && node benchmarks/object-graph.mjs --sizes 100 --targets memory,filesystem/maximum --assert --json --output benchmark-check.json",
    "pack:dry-run": "npm pack --dry-run --cache ./.npm-cache",
    "package:smoke": "node scripts/package-smoke.mjs",
    "prepare": "npm run build",
    "prepack": "npm run build",
    "quality:source": "node scripts/source-quality.mjs",
    "quality": "npm run quality:source && npm run build"
  },
  "keywords": [
    "graphvault",
    "embedded-database",
    "graph-database",
    "object-graph",
    "persistence",
    "local-first",
    "typescript",
    "nestjs",
    "gvql",
    "storage"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=26"
  },
  "peerDependencies": {
    "@nestjs/common": ">=10 || >=11"
  },
  "peerDependenciesMeta": {
    "@nestjs/common": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^22.15.3",
    "typescript": "^5.8.3",
    "c8": "^10.1.3"
  },
  "c8": {
    "check-coverage": true,
    "lines": 80,
    "branches": 70,
    "functions": 80,
    "statements": 80,
    "include": [
      "dist/**/*.js"
    ],
    "exclude": [
      "tests/**/*.js",
      "tests/**/*.mjs"
    ]
  }
}
